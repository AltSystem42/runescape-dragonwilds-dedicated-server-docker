# ---- Server operation ----
SERVER_PORT=7777
ENABLE_AUTO_UPDATE=true
UPDATE_TIME=3600          # seconds between update checks
BACKUP_AFTER_UPDATE=true
BACKUP_DAILY=true
BACKUP_TIME=3:00 AM
BACKUP_RETENTION_DAYS=30
POLL_INTERVAL=60
IDLE_WAIT=360

# ---- Notifications ----
ENABLE_DISCORD_NOTIF=false
DISCORD_WEBHOOK_URL=

# ---- Logging ----
LOG_TO_STDOUT=true
MAX_LOG_SIZE=5242880        # bytes; rotate script log at 5 MB
LOG_RETENTION=5             # rotated generations to keep

# ---- Timezone (used for scheduled backups) ----
TZ=America/New_York

# ---- Server settings (written to DedicatedServer.ini on container start) ----
# Leave a variable empty to keep whatever value already exists in the ini.

# Required: your in-game "My Player Id" (game settings menu) — grants admin.
OWNER_ID=
SERVER_NAME=
DEFAULT_WORLD_NAME=
ADMIN_PASSWORD=
WORLD_PASSWORD=
SERVER_GUID=